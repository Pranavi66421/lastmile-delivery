# Server Configurations
PORT=5000
DATABASE_URL=database.db

# JWT Authentication Secret — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Dynamic Pricing Config
BASE_RATE_B2B=20.00
BASE_RATE_B2C=15.00
INTRA_ZONE_RATE_KG_B2B=5.00
INTRA_ZONE_RATE_KG_B2C=4.00
INTER_ZONE_RATE_KG_B2B=10.00
INTER_ZONE_RATE_KG_B2C=8.00
COD_SURCHARGE_FLAT_B2B=15.00
COD_SURCHARGE_FLAT_B2C=10.00

# Optional SMTP Mail Server settings for real email dispatch
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=no-reply@thinklastmile.com

# Optional Twilio Settings for real SMS notifications
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

